# Keep append-only shard results byte-stable across platforms. Without this,
# git rewrites LF to CRLF on Windows checkout, so the same shard file looks
# modified on one machine and not another and every teammate's commit shows
# spurious whole-file diffs.
data/reference/nisansa_shards/**/*.jsonl text eol=lf
data/reference/nisansa_shards/**/*.json  text eol=lf
*.txt.gz binary
